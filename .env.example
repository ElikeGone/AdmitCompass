# AdmitCompass settings. Copy this file to `.env` in the repo folder OR one level above it (the app checks ./.env first,
# then ../.env; values already set in the environment win). Never commit a real .env. Only PORTKEY_API_KEY is needed.

# ---- Model access (course key; used ONLY with gpt-6-luna) ----
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
ADMITCOMPASS_MODEL=gpt-6-luna
# Low reasoning effort for agent calls (low | medium | high)
ADMITCOMPASS_REASONING_EFFORT=low
# Send "x-portkey-cache-force-refresh: true" so measured tokens are fresh generations (1 = on, 0 = allow cache)
PORTKEY_CACHE_FORCE_REFRESH=1
# Optional; not used by this app (graders' .env may contain it)
OPENAI_API_KEY=

# ---- Per-run budget caps (a run stops cleanly when any cap is reached) ----
ADMITCOMPASS_MAX_REQUESTS_PER_RUN=25
ADMITCOMPASS_MAX_TOKENS_PER_RUN=200000
ADMITCOMPASS_MAX_TOOL_CALLS_PER_RUN=40
ADMITCOMPASS_MAX_SECONDS_PER_RUN=300
ADMITCOMPASS_MAX_COST_USD_PER_RUN=0.25
# Live analyses allowed per server process (protects the course budget)
ADMITCOMPASS_MAX_LIVE_RUNS_PER_SERVER=3

# ---- Prices for cost reports (USD per 1M tokens). Leave blank if unknown: reports then show labeled HYPOTHETICAL scenarios ----
# Price source: none found — no documented gpt-6-luna price on the course site, instructions page or provider config (checked 2026-10-23).
ADMITCOMPASS_PRICE_INPUT_PER_MTOK=
# Price source: (same as above) — cached input tokens
ADMITCOMPASS_PRICE_CACHED_INPUT_PER_MTOK=
# Price source: (same as above) — output tokens, including reasoning tokens
ADMITCOMPASS_PRICE_OUTPUT_PER_MTOK=
# Where the prices above came from (shown in the cost report)
ADMITCOMPASS_PRICE_SOURCE=

# ---- Evidence and demo ----
# Months after which a source's data period is flagged as possibly stale
ADMITCOMPASS_SOURCE_STALE_MONTHS=18
# Fictional demo profiles use only programs with "detailed" evidence (1 = on, 0 = all programs)
AC_DEMO_DETAILED_ONLY=1

# ---- Ask AI copilot ----
# Leave blank for live answers with the key above; set to "mock" for an offline mock (no model calls)
AC_COPILOT_MODE=
AC_COPILOT_PER_MINUTE=6
AC_COPILOT_PER_HOUR=40
AC_COPILOT_PER_CONVERSATION=20
AC_COPILOT_PER_DAY=200

# ---- Accounts (off by default) ----
AC_ENABLE_ACCOUNTS=false
# SQLite file for accounts (default data/app/accounts.sqlite3)
AC_DB_PATH=
# Force the Secure cookie flag (set to 1 behind an HTTPS proxy)
AC_COOKIE_SECURE=
# Extra origins allowed to make state-changing requests (comma-separated)
AC_ALLOWED_ORIGINS=
